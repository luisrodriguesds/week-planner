{
  "name": "gogym-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --config src/web/vite.config.ts\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "tsc && vite build --config src/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "bot:execute": "tsx scripts/execute-plan.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
