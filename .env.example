# GoGym Planner — copy to .env and fill in values (never commit .env)

# --- Server ---
# Bind address (LAN: 0.0.0.0). Do not expose port 3847 to the internet.
HOST=0.0.0.0
PORT=3847
NODE_ENV=development

# Session signing secret (32+ random chars). Optional in dev — auto-generated in data/session.secret
# SESSION_SECRET=

# SQLite database file (created automatically)
DATABASE_PATH=./data/planner.db

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- GoGym API (global) ---
GOGYM_BASE_URL=https://gogym.gomygym.com
GOGYM_CENTER_ID=1
GOGYM_TIMEZONE=Europe/Lisbon

# Used only by `npm run seed:admin` to set the admin user's gogym_idcliente.
# Per-user idcliente is stored in the database (Conta page), not here.
# GOGYM_CLIENT_ID=

# --- Email (Phase 5 — optional until digest/confirmation emails are enabled) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GoGym Planner <noreply@example.com>"

# LAN URL shown in emails (your Windows PC IP, e.g. http://192.168.1.50:3847)
# APP_BASE_URL=http://192.168.1.50:3847
